# Supabase 프로젝트 공개 설정입니다. anon key는 브라우저에 노출 가능한 public key입니다.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 로컬 Supabase Edge Function 테스트 시에만 사용합니다.
# VITE_SUPABASE_RECOMMEND_URL=http://127.0.0.1:54321/functions/v1/recommend

# OpenAI API 키는 여기에 쓰지 않습니다.
# supabase secrets set OPENAI_API_KEY=sk-... 로 Edge Function secret에 저장하세요.
